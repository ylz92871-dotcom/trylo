{$RELAY_DOMAIN} {
    @modelRequests path /relay/model-requests /api/account/model-requests
    request_body @modelRequests {
        max_size 8MiB
    }
    @otherRequests not path /relay/model-requests /api/account/model-requests
    request_body @otherRequests {
        max_size 512KB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        -Server
    }
    reverse_proxy relay:8788
}
