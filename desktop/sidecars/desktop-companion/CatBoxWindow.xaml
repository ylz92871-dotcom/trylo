<Window x:Class="TryloDesktopPet.CatBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trylo Cat Box"
        Width="620" Height="720" MinWidth="500" MinHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="FunTextBrush" Color="#FF2A2219" />
        <SolidColorBrush x:Key="FunSoftBrush" Color="#FF6B5D4F" />
        <SolidColorBrush x:Key="FunMutedBrush" Color="#FFA89785" />
        <SolidColorBrush x:Key="FunAccentBrush" Color="#FFC9846A" />
        <SolidColorBrush x:Key="FunSurfaceBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="FunSurfaceAltBrush" Color="#FFF0EBE4" />

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Margin="2" CornerRadius="4" Background="#55C9846A" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource FunSoftBrush}" />
            <Setter Property="Background" Value="#6AFFFFFF" />
            <Setter Property="BorderBrush" Value="#2DB4A08C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource FunAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{StaticResource FunSoftBrush}" />
            <Setter Property="Background" Value="#66FFFFFF" />
            <Setter Property="BorderBrush" Value="#2DB4A08C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource FunAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.74" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFE0A088" Offset="0" />
                        <GradientStop Color="#FFC9846A" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="FunTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource FunTextBrush}" />
            <Setter Property="BorderBrush" Value="#2DB4A08C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#FFC9846A" />
                                <Setter TargetName="InputBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#55C9846A" BlurRadius="10" ShadowDepth="0" Opacity="0.35" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border CornerRadius="24" BorderBrush="#55FFFFFF" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF8F3ED" Offset="0" />
                    <GradientStop Color="#FFF3ECE4" Offset="0.52" />
                    <GradientStop Color="#FFEDE4DB" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#80000000" BlurRadius="32" ShadowDepth="10" Opacity="0.34" />
            </Border.Effect>

            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Image x:Name="CatBoxBackgroundImage" Grid.RowSpan="2" Stretch="UniformToFill"
                       Opacity="0" IsHitTestVisible="False" />
                <Border x:Name="CatBoxBackgroundWash" Grid.RowSpan="2" Background="#EAF8F3ED"
                        IsHitTestVisible="False" />

                <Border x:Name="TitleBar" Grid.Row="0" Background="#01FFFFFF"
                        PreviewMouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <Grid Margin="24,16,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="角色扮演" Foreground="{StaticResource FunMutedBrush}"
                                       FontSize="11" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="猫箱" Foreground="{StaticResource FunTextBrush}"
                                           FontSize="26" FontWeight="Bold" />
                                <Border Margin="10,6,0,0" Padding="8,3" CornerRadius="8"
                                        Background="#22C9846A" BorderBrush="#33C9846A" BorderThickness="1">
                                    <TextBlock x:Name="ConnectionText" Text="等待 Trylo" Foreground="{StaticResource FunAccentBrush}"
                                               FontSize="10" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource ChromeButton}" Content="—" ToolTip="最小化" Click="OnMinimizeClick" />
                            <Button Style="{StaticResource ChromeButton}" Content="□" ToolTip="最大化/还原" Click="OnMaximizeClick" />
                            <Button Style="{StaticResource ChromeButton}" Content="×" FontSize="17" ToolTip="关闭" Click="OnCloseClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid x:Name="CharacterSelectionView" Margin="24,0,24,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="选择角色开始沉浸式对话"
                                       Foreground="{StaticResource FunSoftBrush}" FontSize="13"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="创建角色"
                                    Click="OnCreateCharacterClick" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <UniformGrid x:Name="CharacterGrid" Columns="2" />
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ChatView" Margin="24,0,24,24" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="16,12" CornerRadius="18"
                                Background="#B8FFFFFF" BorderBrush="#22B4A08C" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#553B2818" BlurRadius="18" ShadowDepth="4" Opacity="0.10" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SoftButton}" Content="← 返回角色列表"
                                        Click="OnBackClick" />
                                <TextBlock x:Name="ChatCharacterText" Grid.Column="1" Margin="14,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource FunTextBrush}"
                                           FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource SoftButton}" Content="编辑角色"
                                            Margin="0,0,6,0" Click="OnEditCharacterClick" />
                                    <Button Style="{StaticResource SoftButton}" Content="背景"
                                            Margin="0,0,6,0" Click="OnBackgroundSettingsClick" />
                                    <Button Style="{StaticResource SoftButton}" Content="气泡"
                                            Margin="0,0,6,0" Click="OnBubbleSettingsClick" />
                                    <Button x:Name="NormalModeButton" Style="{StaticResource SoftButton}" Content="灵动"
                                            Margin="0,0,6,0" Click="OnNormalModeClick" />
                                    <Button x:Name="ThinkModeButton" Style="{StaticResource SoftButton}" Content="思考"
                                            Click="OnThinkModeClick" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Margin="0,16,0,12" CornerRadius="22"
                                Background="#B0FFFFFF" BorderBrush="#28B4A08C" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#663B2818" BlurRadius="24" ShadowDepth="8" Opacity="0.10" />
                            </Border.Effect>
                            <Grid>
                                <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto"
                                              Padding="18">
                                    <StackPanel x:Name="MessagesHost" HorizontalAlignment="Center" />
                                </ScrollViewer>
                                <TextBlock x:Name="EmptyChatText" Text="输入消息开始对话吧"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource FunMutedBrush}" FontSize="13"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Padding="16,14" CornerRadius="20"
                                Background="#C8FFFFFF" BorderBrush="#2DB4A08C" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#553B2818" BlurRadius="20" ShadowDepth="6" Opacity="0.10" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="FunInput" Grid.Row="0" MinHeight="48" MaxHeight="110"
                                         Style="{StaticResource FunTextBox}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         PreviewKeyDown="OnFunInputPreviewKeyDown" />
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                                               Foreground="{StaticResource FunMutedBrush}" FontSize="11"
                                               Text="桌宠猫箱 · 角色聊天" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource SoftButton}" Content="清除对话"
                                                Margin="0,0,8,0" Click="OnClearClick" />
                                        <Button x:Name="StopButton" Style="{StaticResource SoftButton}" Content="停止"
                                                Margin="0,0,8,0" Visibility="Collapsed" Click="OnStopClick" />
                                        <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" Content="发送"
                                                Click="OnSendClick" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="VisualSettingsView" Margin="24,0,24,24" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="VisualSettingsTitle" Text="窗口背景"
                                           Foreground="{StaticResource FunTextBrush}" FontSize="20"
                                           FontWeight="Bold" />
                                <TextBlock Text="给猫箱换一个更沉浸的房间"
                                           Foreground="{StaticResource FunMutedBrush}" FontSize="11"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SoftButton}" Content="完成"
                                    Click="OnCloseVisualSettingsClick" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Padding="16" CornerRadius="18" Background="#AAFFFFFF"
                                        BorderBrush="#22B4A08C" BorderThickness="1" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="背景选择" Foreground="{StaticResource FunTextBrush}"
                                                   FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
                                        <UniformGrid x:Name="BackgroundOptionsHost" Columns="2" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Style="{StaticResource SoftButton}" Content="选择本地背景"
                                                    Margin="0,0,8,0" Click="OnChooseWindowBackgroundClick" />
                                            <Button Style="{StaticResource SoftButton}" Content="清除本地背景"
                                                    Click="OnClearWindowBackgroundClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Padding="16" CornerRadius="18" Background="#AAFFFFFF"
                                        BorderBrush="#22B4A08C" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="聊天气泡" Foreground="{StaticResource FunTextBrush}"
                                                   FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
                                        <UniformGrid x:Name="BubbleOptionsHost" Columns="2" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="EditorView" Margin="24,0,24,24" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="EditorTitle" Text="创建角色"
                                           Foreground="{StaticResource FunTextBrush}" FontSize="20"
                                           FontWeight="Bold" />
                                <TextBlock Text="头像、人物设定和开场白会保存在本地"
                                           Foreground="{StaticResource FunMutedBrush}" FontSize="11"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SoftButton}" Content="取消"
                                    Click="OnCancelEditorClick" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Padding="16" CornerRadius="18" Background="#99FFFFFF"
                                        BorderBrush="#22B4A08C" BorderThickness="1" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="EditorAvatarPreview" Width="76" Height="76" CornerRadius="24"
                                                Background="#FFFFF6EF" BorderBrush="#33C9846A" BorderThickness="1"
                                                Margin="0,0,16,0">
                                            <Grid>
                                                <Image x:Name="EditorAvatarImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                                <TextBlock x:Name="EditorAvatarText" Text="🌸"
                                                           FontFamily="Segoe UI Emoji, Segoe UI Symbol, Microsoft YaHei UI"
                                                           FontSize="28" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="角色头像" Foreground="{StaticResource FunTextBrush}"
                                                       FontWeight="SemiBold" FontSize="13" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Style="{StaticResource SoftButton}" Content="选择图片"
                                                        Margin="0,0,8,0" Click="OnChooseAvatarImageClick" />
                                                <Button Style="{StaticResource SoftButton}" Content="清除图片"
                                                        Click="OnClearAvatarImageClick" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Emoji" Foreground="{StaticResource FunSoftBrush}" FontSize="12" Margin="0,0,0,6" />
                                <TextBox x:Name="EditorEmojiInput" Style="{StaticResource FunTextBox}" MinHeight="42"
                                         MaxLength="4" TextChanged="OnEditorEmojiChanged" Margin="0,0,0,12" />

                                <TextBlock Text="角色名称" Foreground="{StaticResource FunSoftBrush}" FontSize="12" Margin="0,0,0,6" />
                                <TextBox x:Name="EditorNameInput" Style="{StaticResource FunTextBox}" MinHeight="42"
                                         MaxLength="32" Margin="0,0,0,12" />

                                <TextBlock Text="角色简介" Foreground="{StaticResource FunSoftBrush}" FontSize="12" Margin="0,0,0,6" />
                                <TextBox x:Name="EditorDescriptionInput" Style="{StaticResource FunTextBox}" MinHeight="70"
                                         TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12" />

                                <TextBlock Text="角色设定" Foreground="{StaticResource FunSoftBrush}" FontSize="12" Margin="0,0,0,6" />
                                <TextBox x:Name="EditorSystemInput" Style="{StaticResource FunTextBox}" MinHeight="128"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,12" />

                                <TextBlock Text="开场白" Foreground="{StaticResource FunSoftBrush}" FontSize="12" Margin="0,0,0,6" />
                                <TextBox x:Name="EditorOpeningInput" Style="{StaticResource FunTextBox}" MinHeight="78"
                                         TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12" />
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="EditorErrorText" Foreground="#FFD05B4F" FontSize="11"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="保存角色"
                                    Click="OnSaveCharacterClick" />
                        </Grid>
                    </Grid>
                </Grid>

                <ResizeGrip Width="18" Height="18"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,8,8" Opacity="0.46"
                            Panel.ZIndex="20" />
            </Grid>
        </Border>
    </Grid>
</Window>
