<Window x:Class="TryloDesktopPet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trylo Desktop Pet"
        Width="264" Height="272"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseMove="OnMouseMove"
        MouseRightButtonUp="OnMouseRightButtonUp"
        MouseEnter="OnPetMouseEnter"
        MouseLeave="OnPetMouseLeave">
    <Grid x:Name="Root" Margin="6">

        <!-- ── Body glow: soft halo behind the cat, tinted by state ──── -->
        <Ellipse x:Name="BodyGlow" Width="160" Height="100"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,18" IsHitTestVisible="False"
                 Opacity="0" Stretch="Fill">
            <Ellipse.Effect>
                <BlurEffect Radius="38" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- ── Cat sprite ─────────────────────────────────────────────── -->
        <Canvas Width="190" Height="142" VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <Image x:Name="PetSprite" Canvas.Left="3" Canvas.Top="-3" Width="184" Height="146"
                   Stretch="Uniform" SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,0.72">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" />
                        <RotateTransform x:Name="PetRotation" />
                        <TranslateTransform x:Name="PetTranslation" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Canvas>

        <!-- ── Mood bubble: speech-bubble style, only for key moments ── -->
        <Border x:Name="MoodBubble" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,148" Visibility="Collapsed"
                CornerRadius="14" BorderThickness="1.2" Padding="14,9,14,10"
                MaxWidth="220" MinWidth="100">
            <Border.Effect>
                <DropShadowEffect Color="#66000000" BlurRadius="18" ShadowDepth="4"
                                  Direction="270" Opacity="0.45" />
            </Border.Effect>
            <Border.BorderBrush>
                <SolidColorBrush Color="#40FFFFFF" />
            </Border.BorderBrush>
            <Border.Background>
                <SolidColorBrush x:Name="MoodBubbleBg" Color="#E81C2433" />
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- mood text (+ a very light "+N" peer-task hint) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Center" Background="Transparent">
                    <TextBlock x:Name="MoodText"
                               Foreground="#F0F4F8" FontSize="12" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Text="..." />
                    <TextBlock x:Name="MoodMeta" Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="#8C99A8" FontSize="10" FontWeight="SemiBold"
                               Visibility="Collapsed" Text="" />
                </StackPanel>

                <!-- permission buttons (hidden unless needed) -->
                <Grid x:Name="PermissionActions" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="DenyPermissionButton" Grid.Column="0" Height="28"
                            Content="Deny" Click="OnPermissionDenyClick" Cursor="Hand"
                            Foreground="#D9E1EA" FontSize="11" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="DenySurface" CornerRadius="14"
                                        Background="#26FFFFFF" BorderBrush="#40FFFFFF"
                                        BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DenySurface" Property="Background" Value="#3AFFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="DenySurface" Property="Opacity" Value="0.75" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="AllowPermissionButton" Grid.Column="2" Height="28"
                            Content="Allow" Click="OnPermissionAllowClick" Cursor="Hand"
                            Foreground="#08201A" FontSize="11" FontWeight="Bold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="AllowSurface" CornerRadius="14" BorderThickness="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                            <GradientStop Color="#FF8CF2C8" Offset="0" />
                                            <GradientStop Color="#FF5BD9A4" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#6672E5B5" BlurRadius="10"
                                                          ShadowDepth="2" Opacity="0.6" />
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="AllowSurface" Property="Opacity" Value="0.92" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="AllowSurface" Property="Opacity" Value="0.72" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- bubble tail (triangle pointing down) -->
        <Path x:Name="MoodTail" Visibility="Collapsed"
              HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Margin="0,0,0,138" Width="14" Height="8"
              Data="M0,0 L7,8 L14,0 Z" Stretch="Fill">
            <Path.Fill>
                <SolidColorBrush x:Name="MoodTailFill" Color="#E81C2433" />
            </Path.Fill>
        </Path>

    </Grid>
</Window>
