{
  "name": "trylo-desktop",
  "version": "2.1.0",
  "private": true,
  "description": "Trylo Desktop — Agent-native IDE shell (Tauri 2 + React + monaco-vscode-api)",
  "type": "module",
  "scripts": {
    "check:layout": "node ../scripts/check-workspace-layout.mjs",
    "dev": "vite",
    "build": "node ../scripts/check-workspace-layout.mjs && tsc -b && vite build",
    "build:bundle": "node scripts/build/prepare.mjs && pnpm build",
    "preview": "vite preview",
    "tauri": "node scripts/run-tauri.mjs",
    "tauri:dev": "node scripts/start-desktop-dev.mjs",
    "tauri:build": "node scripts/run-tauri.mjs build",
    "build:portable-launcher": "node scripts/build/windows/build-portable-launcher.mjs",
    "lint": "node ../scripts/check-workspace-layout.mjs && eslint src --ext ts,tsx --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm test:node",
    "test:watch": "vitest",
    "spike:day-1": "echo 'Spike Day 1 archive: ../_workspace/archive/tracked/desktop-spike-history-20261107/day-1-tauri-setup.md'",
    "spike:day-2": "echo 'Spike Day 2 archive: ../_workspace/archive/tracked/desktop-spike-history-20261107/day-2-monaco-vscode-api.md'",
    "spike:day-3": "echo 'Spike Day 3 archive: ../_workspace/archive/tracked/desktop-spike-history-20261107/day-3-fs-bridge.md'",
    "spike:day-4": "echo 'Spike Day 4 archive: ../_workspace/archive/tracked/desktop-spike-history-20261107/day-4-watcher.md'",
    "spike:day-5": "echo 'Spike Day 5 archive: ../_workspace/archive/tracked/desktop-spike-history-20261107/day-5-external-process.md'",
    "spike:day-6": "echo 'Spike Day 6 archive: ../_workspace/archive/tracked/desktop-spike-history-20261107/day-6-search.md'",
    "spike:day-7": "echo 'Spike Day 7 archive: ../_workspace/archive/tracked/desktop-spike-history-20261107/day-7-report.md'",
    "test:node": "node --test scripts/ensure-dev-cli.test.mjs scripts/stage-npm.test.mjs",
    "test:platform": "node --test scripts/runtime-integrity.platform.test.mjs scripts/native-dev-build.platform.test.mjs scripts/background-console.platform.test.mjs scripts/portable-launcher.platform.test.mjs"
  },
  "dependencies": {
    "@codingame/monaco-vscode-api": "^13.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chart.js": "^4.5.1",
    "docx-preview": "^0.4.0",
    "dxf-parser": "^1.1.2",
    "gerber-to-svg": "^4.2.8",
    "hls.js": "1.7.4",
    "jszip": "^3.10.1",
    "libheif-js": "1.23.5",
    "lucide-react": "^1.31.0",
    "monaco-editor": "^0.52.0",
    "monaco-languageclient": "^9.0.0",
    "occt-import-js": "0.0.23",
    "pdfjs-dist": "^6.3.289",
    "pptxviewjs": "^1.1.9",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.12",
    "remark-gfm": "4.0.1",
    "three": "^0.185.1",
    "utif": "3.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
