{
  "name": "trylo-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Trylo Desktop — Agent-native IDE shell (Tauri 2 + React + monaco-vscode-api)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-sidecars.ps1 && pnpm build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint src --ext ts,tsx --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codingame/monaco-vscode-api": "^13.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chart.js": "^4.5.1",
    "docx-preview": "^0.4.0",
    "dxf-parser": "^1.1.2",
    "gerber-to-svg": "^4.2.8",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "monaco-editor": "^0.52.0",
    "monaco-languageclient": "^9.0.0",
    "pdfjs-dist": "^6.3.289",
    "pptxviewjs": "^1.1.9",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.12",
    "three": "^0.185.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
